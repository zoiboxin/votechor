@echo off
setlocal EnableExtensions EnableDelayedExpansion
title VoteChor - Local Launcher

cd /d "%~dp0"
set "ROOT=%~dp0"

echo.
echo  ============================================================
echo    VoteChor - one-click launcher for Windows 10 / 11
echo    Checks every prerequisite, builds the game, starts
echo    BOTH servers and opens http://localhost:3000
echo  ============================================================
echo.

REM ---------- 1) bun - the only hard requirement ----------
where bun >nul 2>nul
if not errorlevel 1 goto HAVE_BUN
echo  [X] "bun" is not installed - it is the only requirement.
echo.
echo      Install it with:   powershell -c "irm bun.sh/install.ps1 | iex"
echo.
set /p INSTALLBUN="     Download and install bun now? [Y/N]: "
if /I not "%INSTALLBUN%"=="Y" goto NEED_BUN
echo  [..] installing bun ...
powershell -NoProfile -ExecutionPolicy Bypass -Command "irm bun.sh/install.ps1 | iex"
set "PATH=%USERPROFILE%\.bun\bin;%PATH%"
where bun >nul 2>nul
if errorlevel 1 goto NEED_BUN
:HAVE_BUN
for /f "delims=" %%v in ('bun --version') do set "BUNVER=%%v"
echo  [OK] bun %BUNVER%
echo.

REM ---------- 2) git - optional, used only to detect updates ----------
where git >nul 2>nul
if errorlevel 1 echo  [i] git not found - optional, needed only for updates via git pull
echo.

REM ---------- 3) curl - ships with Windows 10 1803+ / 11 ----------
where curl >nul 2>nul
if errorlevel 1 echo  [X] curl.exe not found - it ships with Windows 10 1803+ / 11.
if errorlevel 1 goto FAIL

REM ---------- 3b) node.js - recommended for the WebSocket relay ----------
where node >nul 2>nul
if errorlevel 1 (
    echo  [i] Node.js not found - optional but RECOMMENDED: the web server uses
    echo      it to relay WebSocket game traffic ^(polling fallback works without^).
    echo      Install once with:  winget install OpenJS.NodeJS.LTS
) else (
    for /f "delims=" %%v in ('node --version') do echo  [OK] node %%v - WebSocket relay ready
)
echo.

REM ---------- 4) runtime configuration (.env.local) ----------
if exist ".env.local" goto ENV_PATCH
>  ".env.local" echo # VoteChor local config - generated by start-windows.bat
>> ".env.local" echo # NEXT_PUBLIC_GAME_SERVER_URL: leave EMPTY to auto-detect the game
>> ".env.local" echo # server (localhost or LAN-IP, port 3002). Set it only when the game
>> ".env.local" echo # server runs on a DIFFERENT machine, e.g. http://192.168.1.50:3002
>> ".env.local" echo NEXT_PUBLIC_GAME_SERVER_URL=
>> ".env.local" echo DATABASE_URL=file:../db/custom.db
echo  [OK] created .env.local
goto ENV_DONE
:ENV_PATCH
findstr /B /C:"DATABASE_URL=" ".env.local" >nul 2>nul
if errorlevel 1 echo DATABASE_URL=file:../db/custom.db>>".env.local"
findstr /B /C:"NEXT_PUBLIC_GAME_SERVER_URL=" ".env.local" >nul 2>nul
if errorlevel 1 echo NEXT_PUBLIC_GAME_SERVER_URL=>>".env.local"
echo  [OK] .env.local present - required keys verified
REM v92: a public domain with :3002 in NEXT_PUBLIC_GAME_SERVER_URL can never work
REM (Cloudflare's proxy does not accept port 3002) - warn loudly; the game now
REM auto-relays through the web server anyway.
findstr /B /C:"NEXT_PUBLIC_GAME_SERVER_URL=" ".env.local" | findstr /C:":3002" >nul 2>nul
if not errorlevel 1 (
    echo  [!] WARNING: NEXT_PUBLIC_GAME_SERVER_URL points at port 3002 through a
    echo      domain - that port can NEVER be reached through Cloudflare/domains.
    echo      LEAVE IT EMPTY ^(NEXT_PUBLIC_GAME_SERVER_URL=^) - the game connects
    echo      through the web server automatically. Fix .env.local + REBUILD.
)
:ENV_DONE
REM Schema-relative DATABASE_URL for every child process (prisma + servers).
set "DATABASE_URL=file:../db/custom.db"
echo.

REM ---------- 5) dependencies (root + game server) ----------
echo  [..] installing dependencies - fast when already done ...
call bun install
if errorlevel 1 goto FAIL_INSTALL
pushd "mini-services\game-server"
call bun install
if errorlevel 1 popd & goto FAIL_INSTALL
popd
echo  [OK] dependencies ready
echo.

REM ---------- 6) prisma client + database ----------
echo  [..] preparing the database (db\custom.db) ...
call bun run db:generate
if errorlevel 1 goto FAIL_DB
call bun run db:push
if errorlevel 1 goto FAIL_DB
echo  [OK] database ready
echo.

REM ---------- 7) stop leftovers from a previous run ----------
echo  [..] stopping previous instances on ports 3000/3002 if any ...
powershell -NoProfile -Command "Get-NetTCPConnection -LocalPort 3000,3002 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { try { Stop-Process -Id $_ -Force -ErrorAction Stop } catch {} }" >nul 2>nul
ping -n 2 127.0.0.1 >nul

REM ---------- 8) firewall rules for LAN play - needs admin, ignored otherwise ----------
netsh advfirewall firewall add rule name="VoteChor Web 3000" dir=in action=allow protocol=TCP localport=3000 >nul 2>nul
netsh advfirewall firewall add rule name="VoteChor Game 3002" dir=in action=allow protocol=TCP localport=3002 >nul 2>nul

REM ---------- 9) build (skipped when up to date) ----------
set "NEEDBUILD=1"
if exist ".next\BUILD_ID" set "NEEDBUILD=0"
if not exist ".build-commit" goto BUILD_ASK
where git >nul 2>nul
if errorlevel 1 goto BUILD_ASK
for /f "delims=" %%c in ('git rev-parse HEAD 2^>nul') do (
    findstr /C:"%%c" ".build-commit" >nul 2>nul
    if errorlevel 1 set "NEEDBUILD=1"
)
:BUILD_ASK
if "!NEEDBUILD!"=="1" goto DOBUILD
echo  [OK] existing build found.
set /p REBUILD="     Rebuild anyway? (press Y after a git pull) [y/N]: "
if /I "%REBUILD%"=="Y" goto DOBUILD
goto BUILD_DONE
:DOBUILD
echo  [..] building the web app - 2-4 minutes, only needed once per update ...
call bun run build
if errorlevel 1 goto FAIL_BUILD
where git >nul 2>nul
if not errorlevel 1 git rev-parse HEAD>".build-commit"
echo  [OK] build complete
echo.
:BUILD_DONE

REM ---------- 10) start both servers, each in its own window ----------
echo  [..] starting the game server (port 3002) ...
start "VoteChor GAME SERVER (port 3002)" "%ROOT%run-game-server.bat"
echo  [..] starting the web server (port 3000) ...
start "VoteChor WEB (port 3000)" "%ROOT%run-web-server.bat"

REM ---------- 11) wait for both, then open the browser ----------
echo  [..] waiting for the web server ...
set /a TRIES=0
:WAIT_WEB
set /a TRIES+=1
curl -s -o nul --max-time 3 http://localhost:3000/api/version
if not errorlevel 1 goto WEB_UP
if %TRIES% GEQ 45 goto FAIL_WEB
ping -n 3 127.0.0.1 >nul
goto WAIT_WEB
:WEB_UP
echo  [OK] web server is up on http://localhost:3000
echo  [..] waiting for the game server ...
del "%TEMP%\votechor-gs.json" 2>nul
set /a GTRIES=0
:WAIT_GAME
set /a GTRIES+=1
curl -s --max-time 3 http://localhost:3002/ >"%TEMP%\votechor-gs.json" 2>nul
findstr /C:"ok" "%TEMP%\votechor-gs.json" >nul 2>nul
if not errorlevel 1 goto GAME_UP
if %GTRIES% GEQ 20 goto FAIL_GAME
ping -n 3 127.0.0.1 >nul
goto WAIT_GAME
:GAME_UP
echo  [OK] game server is up on port 3002 - bots and crowd will appear
echo.
start "" http://localhost:3000

echo  ============================================================
echo    VoteChor is running!
echo.
echo      Game:        http://localhost:3000  - opened in your browser
echo      Web server:  port 3000  - window "VoteChor WEB"
echo      Game server: port 3002  - window "VoteChor GAME SERVER"
echo.
echo    - Bots, players, cars and zombies come from the GAME SERVER
echo      window. Keep BOTH windows open while playing!
echo    - Stop the game: close both server windows, or run
echo      stop-windows.bat
echo    - Friends on the same Wi-Fi: open http://YOUR-PC-IP:3000
echo      (run "ipconfig" to see your PC IP - allow firewall)
echo    - Own domain (Cloudflare Tunnel): point the tunnel at
echo      http://localhost:3000 ONLY - the web server relays the game
echo      traffic to 3002 itself. Leave NEXT_PUBLIC_GAME_SERVER_URL
echo      EMPTY. See WINDOWS-SETUP.md, section "Cloudflare Tunnel".
echo  ============================================================
echo.
pause
exit /b 0

REM ---------- failure handlers ----------
:NEED_BUN
echo.
echo  [X] bun is still missing. Install it from https://bun.sh then re-run this file.
goto FAIL
:FAIL_INSTALL
echo  [X] "bun install" failed. Check your internet connection and re-run this file.
goto FAIL
:FAIL_DB
echo  [X] database preparation failed.
echo      Make sure this folder is writable and no antivirus blocked prisma,
echo      then re-run this file.
goto FAIL
:FAIL_BUILD
echo  [X] build failed. Re-run this file to try again.
goto FAIL
:FAIL_WEB
echo  [X] the web server did not come up on port 3000.
echo      Look at the "VoteChor WEB (port 3000)" window for the error.
echo      If you just updated the game, re-run this file and choose REBUILD.
goto FAIL
:FAIL_GAME
echo  [X] the game server did not come up on port 3002.
echo      Look at the "VoteChor GAME SERVER" window for the error.
echo      If Windows Firewall asked, click ALLOW.
goto FAIL
:FAIL
echo.
pause
exit /b 1
